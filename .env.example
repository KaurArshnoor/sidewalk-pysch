# Real study snapshot (included in the repo). Configure your model provider before running.
SIDEWALK_DATASET=data/processed/study
SIDEWALK_MODEL=vertex_ai/gemini-3.5-flash-lite
VERTEX_LOCATION=global

# Vertex AI: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=your-project
# VERTEXAI_PROJECT=your-project
# VERTEXAI_LOCATION=global
# CENSUS_API_KEY=your-activated-key (only needed for direct API imports)

# Literature agent (optional): a free OpenAlex key raises the shared anonymous daily budget.
# See docs/external-apis.md. Everything works without it.
# OPENALEX_API_KEY=
